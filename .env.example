# LLM
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.xxxx:PASS@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres:PASS@db.xxxx.supabase.co:5432/postgres

# Weather
WEATHER_PROVIDER=open-meteo        # open-meteo | owm | mock
OWM_API_KEY=

# Guardrails / behaviour
GUARD_MODE=enforce                 # enforce | shadow
HISTORY_LIMIT=12
SPECULATIVE_ENABLED=false
AUDIO_MODE=webspeech               # webspeech | gemini-tts (phase 9, optional)

# App
APP_ENV=dev                        # dev | staging | prod
APP_BASE_URL=http://localhost:8000
# Absolute URL of this app, emitted as `apiBase` by GET /config.js. Leave empty for
# local/dev (relative fetches). Set to the Fly app's URL when the static client is
# published elsewhere (see scripts/upload_static.py).
PUBLIC_API_BASE=
CORS_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
SENTRY_DSN=
TURNSTILE_SITE_KEY=
# Shared secret for POST /internal/audit/run (pg_cron -> pg_net calls this
# endpoint every 10 minutes; see supabase/migrations/20260821000800_audit_sample.sql).
# Must match `app.internal_token` set in the database via:
#   alter database postgres set app.internal_token = '...';
# Leave unset to disable the endpoint (503).
INTERNAL_TOKEN=
